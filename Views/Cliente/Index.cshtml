@{
    ViewData["Title"] = "Cliente";
}

<div class="cliente-page">

    <h1>Meus Pedidos </h1>

    <!-- BOTÃO NOVO PEDIDO -->
    <a asp-controller="Cliente" asp-action="Produtos">
    <button class="btn-novo">+ Novo Pedido</button>
	</a>

    <!-- LISTA DE PEDIDOS -->
    @foreach (var pedido in ViewBag.Pedidos)
    {
        <div class="pedido">
            <p>@pedido</p>
        </div>
    }

      

    </div>

</div>