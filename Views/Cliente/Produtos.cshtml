@model List<LogiSmartMVC.Models.Produto>

<h1>Produtos Disponíveis </h1>

<table border="1" cellpadding="10">
    <tr>
        <th>Nome</th>
        <th>Preço</th>
        <th>Estoque</th>
        <th>Ação</th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Nome</td>
            <td>R$ @p.Preco.ToString("F2")</td>
            <td>@p.Quantidade</td>
            <td>
                @if (p.Quantidade > 0)
                {
                    <form asp-action="Comprar" method="post">
                        <input type="hidden" name="id" value="@p.Id" />
                        <button type="submit">Comprar</button>
                    </form>
                }
                else
                {
                    <span style="color:red;">Indisponível</span>
                }
            </td>
        </tr>
    }
</table>